# Standalone local HTTPS server for Hermes Office add-ins (without Hermes backend).
# Copy this file to "Caddyfile" and run with:  caddy run
#
# Serves built bundles over HTTPS + config.json for provider credentials.
# No reverse proxy needed — add-ins call providers directly from their WebView.

localhost:8643 {
    # Serve Word bundle.
    handle_path /word/* {
        root * word/dist
        file_server
    }

    # Serve Excel bundle.
    handle_path /excel/* {
        root * excel/dist
        file_server
    }

    # Serve provider config.
    handle /config.json {
        root * .
        file_server
    }

    # Redirect everything else to Word taskpane.
    redir / https://localhost:8643/word/taskpane.html
}
