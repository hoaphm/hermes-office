# Local Gateway for the Hermes Office add-ins.
#
# Do not edit this file to configure a Provider — run `npm run setup`, which
# copies this template to "Caddyfile" (git-ignored) and fills in the proxy block
# below. Start it with `npm run serve`.
#
# The Gateway does two jobs:
#   1. serves the built bundles and config.json to Word/Excel
#   2. forwards /v1/* to the Provider with the API key attached (ADR-0002), so
#      the key is never served to the WebView and never lands in a bundle
#
# Every provider call goes through here rather than straight from the add-in
# (ADR-0001): same-origin means the browser sends no CORS preflight, which is
# what most self-hosted routers fail.
#
# SECURITY — deliberately NO Access-Control-Allow-Origin header. The task panes
# are same-origin with this server, so they need none. A wildcard would let any
# page in any browser on this machine drive your Provider through the proxy.

https://localhost:8643 {
    tls internal

    # Serve the Word bundle.
    handle_path /word/* {
        root * ./word/dist
        file_server
    }

    # Serve the Excel bundle.
    handle_path /excel/* {
        root * ./excel/dist
        file_server
    }

    # Serve {model, customFunctions} to the task panes. Holds no secret.
    handle /config.json {
        root * .
        file_server
    }

    # scripts/setup.mjs replaces EVERYTHING between these two markers, and only
    # that. Hand edits elsewhere in this file survive re-running setup; edits in
    # here do not. The markers must stay.
    # >>> hermes-proxy >>>
    # (run `npm run setup` to generate the Provider proxy)
    # <<< hermes-proxy <<<

    # Bare root is a convenience redirect to the Word task pane.
    redir / https://localhost:8643/word/taskpane.html
}
